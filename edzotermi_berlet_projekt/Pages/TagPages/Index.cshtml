@page
@model edzotermi_berlet_projekt.Pages.TagPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Tag[0].Nev)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tag[0].Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tag[0].Telefon)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tag[0].RegisztracioDatum)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tag[0].Berletek)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Tag) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nev)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.Telefon)
            </td>
            <td>
                @Html.DisplayFor(model => item.RegisztracioDatum)
            </td>
            <td>
                @Html.DisplayFor(model => item.Berletek)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
