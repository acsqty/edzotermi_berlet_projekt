@page
@model edzotermi_berlet_projekt.Pages.TagPages.IndexModel

@{
    ViewData["Title"] = "Tagok";
}

<h1>Edzőtermi tagok</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Új tag felvétele</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Név</th>
            <th>E-mail</th>
            <th>Telefonszám</th>
            <th>Regisztráció dátuma</th>
            <th>Bérletek száma</th>
            <th>Műveletek</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Tag.Count == 0)
        {
            <tr>
                <td colspan="6">Még nincs regisztrált tag.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model.Tag)
            {
                <tr>
                    <td>@item.Nev</td>
                    <td>@item.Email</td>
                    <td>@item.Telefon</td>
                    <td>@item.RegisztracioDatum.ToString("yyyy. MM. dd.")</td>
                    <td>@item.Berletek.Count</td>
                    <td>
                        <a asp-page="./Edit"
                           asp-route-id="@item.Id">Szerkesztés</a>
                        |
                        <a asp-page="./Details"
                           asp-route-id="@item.Id">Részletek</a>
                        |
                        <a asp-page="./Delete"
                           asp-route-id="@item.Id">Törlés</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
