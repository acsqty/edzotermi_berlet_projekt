@page
@model edzotermi_berlet_projekt.Pages.TagPages.DeleteModel

@{
    ViewData["Title"] = "Tag törlése";
}

<h1>Tag törlése</h1>
<p class="text-muted">A tag törlése előtt ellenőrizd az alábbi adatokat.</p>

<div class="alert alert-warning">
    <strong>Biztosan törölni szeretnéd ezt a tagot?</strong>
    Ez a művelet nem vonható vissza.
</div>

<hr />

<dl class="row">
    <dt class="col-sm-3">Név</dt>
    <dd class="col-sm-9">@Model.Tag.Nev</dd>

    <dt class="col-sm-3">E-mail-cím</dt>
    <dd class="col-sm-9">@Model.Tag.Email</dd>

    <dt class="col-sm-3">Telefonszám</dt>
    <dd class="col-sm-9">@Model.Tag.Telefon</dd>

    <dt class="col-sm-3">Regisztráció dátuma</dt>
    <dd class="col-sm-9">
        @Model.Tag.RegisztracioDatum.ToString("yyyy. MM. dd. HH:mm")
    </dd>
</dl>

<form method="post" class="mt-4">
    <input type="hidden" asp-for="Tag.Id" />

    <button type="submit" class="btn btn-danger">
        Tag törlése
    </button>

    <a asp-page="./Index" class="btn btn-secondary">
        Mégse, vissza a listához
    </a>
</form>