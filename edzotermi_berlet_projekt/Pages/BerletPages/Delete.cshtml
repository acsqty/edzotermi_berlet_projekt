@page
@model edzotermi_berlet_projekt.Pages.BerletPages.DeleteModel

@{
    ViewData["Title"] = "Bérlet törlése";
}

<h1>Bérlet törlése</h1>

<div class="alert alert-warning mt-3">
    Biztosan törölni szeretnéd ezt a bérletet?

    A művelet nem vonható vissza.
</div>

<hr />

<dl class="row">
    <dt class="col-sm-3">Tag neve</dt>
    <dd class="col-sm-9">
        @(Model.Berlet.Tag?.Nev ?? "Ismeretlen tag")
    </dd>

    <dt class="col-sm-3">Bérlet típusa</dt>
    <dd class="col-sm-9">
        @(Model.Berlet.BerletTipus?.Nev ?? "Ismeretlen bérlettípus")
    </dd>

    <dt class="col-sm-3">Vásárlás dátuma</dt>
    <dd class="col-sm-9">
        @Model.Berlet.Vasarlas.ToString("yyyy. MM. dd.")
    </dd>

    <dt class="col-sm-3">Lejárat dátuma</dt>
    <dd class="col-sm-9">
        @Model.Berlet.Lejarat.ToString("yyyy. MM. dd.")
    </dd>

    <dt class="col-sm-3">Felhasznált belépések</dt>
    <dd class="col-sm-9">
        @Model.Berlet.FelhasznaltBelepes
    </dd>

    <dt class="col-sm-3">Vásárláskori ár</dt>
    <dd class="col-sm-9">
        @Model.Berlet.VasarlasiAr.ToString("N0") Ft
    </dd>
</dl>

<form method="post" class="mt-3">
    <input type="hidden" asp-for="Berlet.Id" />

    <button type="submit" class="btn btn-danger">
        Bérlet törlése
    </button>

    <a asp-page="./Index" class="btn btn-secondary">
        Mégse, vissza a listához
    </a>
</form>