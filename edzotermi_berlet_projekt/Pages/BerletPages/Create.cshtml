@page
@model edzotermi_berlet_projekt.Pages.BerletPages.CreateModel

@{
    ViewData["Title"] = "Bérlet vásárlása";
}

<h1>Bérlet vásárlása</h1>
<hr />

<div class="row">
    <div class="col-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Berlet.TagId" class="control-label">Tag</label>
                <select asp-for="Berlet.TagId"
                        asp-items="ViewBag.TagId"
                        class="form-select"
                        id="tagValaszto">
                    <option value="">-- Válassz tagot --</option>
                </select>
                <span asp-validation-for="Berlet.TagId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Berlet.BerletTipusId" class="control-label">
                    Bérlettípus
                </label>
                <select asp-for="Berlet.BerletTipusId"
                        asp-items="ViewBag.BerletTipusId"
                        class="form-select">
                    <option value="">-- Válassz bérlettípust --</option>
                </select>
                <span asp-validation-for="Berlet.BerletTipusId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Berlet.Vasarlas" class="control-label">
                    Vásárlás dátuma
                </label>
                <input asp-for="Berlet.Vasarlas"
                       type="date"
                       class="form-control"
                       id="vasarlasDatum" />
                <span asp-validation-for="Berlet.Vasarlas" class="text-danger"></span>
            </div>

            <p class="text-muted">
                A vásárlás dátuma nem lehet korábbi a tag regisztrációjánál.
                A lejárati dátumot a rendszer automatikusan kiszámítja.
            </p>

            <button type="submit" class="btn btn-primary">
                Bérlet megvásárlása
            </button>

            <a asp-page="./Index" class="btn btn-secondary">
                Vissza a listához
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const tagValaszto = document.getElementById("tagValaszto");
        const vasarlasDatum = document.getElementById("vasarlasDatum");

        async function tagDatumFrissitese() {
            const tagId = tagValaszto.value;

            if (!tagId) {
                vasarlasDatum.removeAttribute("min");
                return;
            }

            try {
                const url = `?handler=TagRegisztracioDatum&tagId=${encodeURIComponent(tagId)}`;
                const response = await fetch(url);

                if (!response.ok) {
                    return;
                }

                const adat = await response.json();
                vasarlasDatum.min = adat.minDate;

                if (vasarlasDatum.value < adat.minDate) {
                    vasarlasDatum.value = adat.minDate;
                }
            } catch (error) {
                console.error("A regisztráció dátumának lekérése sikertelen.", error);
            }
        }

        tagValaszto.addEventListener("change", tagDatumFrissitese);

        tagDatumFrissitese();
    </script>
}
