@page
@model edzotermi_berlet_projekt.Pages.BerletPages.IndexModel

@{
    ViewData["Title"] = "Bérletek";
}

<h1>Bérletek</h1>
<p class="text-muted">
    A megvásárolt bérletek, érvényességük és a belépések kezelése.
</p>

@if (TempData["Siker"] != null)
{
    <div class="alert alert-success">@TempData["Siker"]</div>
}

@if (TempData["Hiba"] != null)
{
    <div class="alert alert-danger">@TempData["Hiba"]</div>
}

<p class="mb-4">
    <a asp-page="Create" class="btn btn-primary">
        + Új bérlet vásárlása
    </a>
</p>

<form method="get" class="mb-4">
    <label for="szures" class="form-label fw-semibold">Bérletek szűrése</label>
    <div class="d-flex flex-wrap gap-2">
        <select id="szures" name="szures" class="form-select" style="max-width: 340px;">
            <option value="osszes" selected="@(Model.Szures == "osszes")">Összes bérlet</option>
            <option value="ervenyes" selected="@(Model.Szures == "ervenyes")">Érvényes bérletek</option>
            <option value="lejart" selected="@(Model.Szures == "lejart")">Lejárt bérletek</option>
            <option value="hamarosan" selected="@(Model.Szures == "hamarosan")">Hamarosan lejárók (7 napon belül)</option>
            <option value="elfogyott" selected="@(Model.Szures == "elfogyott")">Elfogyott bérletek</option>
        </select>

        <button type="submit" class="btn btn-secondary">Szűrés</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Tag</th>
                <th>Bérlettípus</th>
                <th>Vásárlás</th>
                <th>Lejárat</th>
                <th>Felhasznált belépések</th>
                <th>Állapot</th>
                <th>Műveletek</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Berlet.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        Nincs a szűrésnek megfelelő bérlet.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Berlet)
                {
                    <tr>
                        <td class="fw-semibold">
                            @(item.Tag?.Nev ?? "Ismeretlen tag")
                        </td>
                        <td>@(item.BerletTipus?.Nev ?? "Ismeretlen típus")</td>
                        <td>@item.Vasarlas.ToString("yyyy. MM. dd.")</td>
                        <td>@item.Lejarat.ToString("yyyy. MM. dd.")</td>
                        <td>
                            @if (item.BerletTipus?.BelepesekSzama.HasValue == true)
                            {
                                @($"{item.FelhasznaltBelepes} / {item.BerletTipus.BelepesekSzama.Value}")
                            }
                            else
                            {
                                <span>Korlátlan</span>
                            }
                        </td>
                        <td>
                            @if (item.Lejarat.Date < DateTime.Today)
                            {
                                <span class="badge bg-danger">Lejárt</span>
                            }
                            else if (item.BerletTipus?.BelepesekSzama.HasValue == true &&
                                     item.FelhasznaltBelepes >= item.BerletTipus.BelepesekSzama.Value)
                            {
                                <span class="badge bg-warning text-dark">Elfogyott</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Érvényes</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                @if (item.Lejarat.Date >= DateTime.Today &&
                                     (!item.BerletTipus!.BelepesekSzama.HasValue ||
                                      item.FelhasznaltBelepes < item.BerletTipus.BelepesekSzama.Value))
                                {
                                    <form method="post" asp-page-handler="Belepes" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="szures" value="@Model.Szures" />
                                        <button type="submit" class="btn btn-sm btn-success">
                                            Belépés rögzítése
                                        </button>
                                    </form>
                                }

                                <a asp-page="./Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-info">
                                    Részletek
                                </a>

                                <a asp-page="./Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Szerkesztés
                                </a>

                                <a asp-page="./Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Törlés
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>