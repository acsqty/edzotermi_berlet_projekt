
<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Edzőtermi bérletkezelő</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/edzotermi_berlet_projekt.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">
                    Edzőtermi bérletkezelő
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#foMenu"
                        aria-controls="foMenu"
                        aria-expanded="false"
                        aria-label="Navigáció megnyitása">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="foMenu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">Kezdőlap</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/TagPages/Index">Tagok</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/BerletTipusPages/Index">Bérlettípusok</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/BerletPages/Index">Bérletek</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" asp-page="/KimutatasPages/Index">
                                Bevételi kimutatás
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container py-3">
            &copy; @DateTime.Today.Year - Edzőtermi bérletkezelő
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
