@page
@model edzotermi_berlet_projekt.Pages.BerletTipusPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.BerletTipus[0].Nev)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BerletTipus[0].ErvenyessegNap)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BerletTipus[0].BelepesekSzama)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BerletTipus[0].Ar)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BerletTipus[0].Berletek)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.BerletTipus) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nev)
            </td>
            <td>
                @Html.DisplayFor(model => item.ErvenyessegNap)
            </td>
            <td>
                @Html.DisplayFor(model => item.BelepesekSzama)
            </td>
            <td>
                @Html.DisplayFor(model => item.Ar)
            </td>
            <td>
                @Html.DisplayFor(model => item.Berletek)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
