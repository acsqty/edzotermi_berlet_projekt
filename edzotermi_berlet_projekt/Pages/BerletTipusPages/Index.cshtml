@page
@model edzotermi_berlet_projekt.Pages.BerletTipusPages.IndexModel

@{
    ViewData["Title"] = "Bérlettípusok";
}

<h1>Bérlettípusok</h1>

<p class="text-secondary">
    Az edzőteremben elérhető bérlettípusok, árak és érvényességi idők kezelése.
</p>

<p>
    <a asp-page="./Create" class="btn btn-primary">
        + Új bérlettípus felvétele
    </a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Név</th>
                <th>Érvényesség</th>
                <th>Belépések száma</th>
                <th>Ár</th>
                <th>Kapcsolódó bérletek</th>
                <th>Műveletek</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.BerletTipus.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-secondary py-4">
                        Még nincs rögzített bérlettípus.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.BerletTipus)
                {
                    <tr>
                        <td class="fw-semibold">@item.Nev</td>
                        <td>@item.ErvenyessegNap nap</td>
                        <td>
                            @if (item.BelepesekSzama.HasValue)
                            {
                                @($"{item.BelepesekSzama.Value} alkalom")
                            }
                            else
                            {
                                <span class="badge bg-success">Korlátlan</span>
                            }
                        </td>
                        <td class="fw-semibold">@item.Ar.ToString("N0") Ft</td>
                        <td>@(item.Berletek?.Count ?? 0) db</td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-page="./Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Szerkesztés
                                </a>
                                <a asp-page="./Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-info">
                                    Részletek
                                </a>
                                <a asp-page="./Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Törlés
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
