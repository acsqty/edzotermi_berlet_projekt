@page
@model edzotermi_berlet_projekt.Pages.BerletTipusPages.DeleteModel

@{
    ViewData["Title"] = "Bérlettípus törlése";
}

<h1>Bérlettípus törlése</h1>

<div class="card mb-4">
    <div class="card-header">
        <h4 class="mb-0">@Model.BerletTipus.Nev</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Érvényesség</dt>
            <dd class="col-sm-9">@Model.BerletTipus.ErvenyessegNap nap</dd>

            <dt class="col-sm-3">Belépések száma</dt>
            <dd class="col-sm-9">
                @if (Model.BerletTipus.BelepesekSzama.HasValue)
                {
                    @Model.BerletTipus.BelepesekSzama
                }
                else
                {
                    <span>Korlátlan</span>
                }
            </dd>

            <dt class="col-sm-3">Ár</dt>
            <dd class="col-sm-9">@Model.BerletTipus.Ar.ToString("N0") Ft</dd>
        </dl>
    </div>
</div>

@if (Model.VanKapcsolodoBerlet)
{
    <div class="alert alert-danger">
        <strong>A bérlettípus nem törölhető!</strong>
        <p class="mb-0">
            Már tartozik hozzá megvásárolt bérlet.
            A korábbi vásárlások megőrzése érdekében a törlés nem engedélyezett.
        </p>
    </div>

    <a asp-page="./Index" class="btn btn-secondary">
        Vissza a bérlettípusokhoz
    </a>
}
else
{
    <div class="alert alert-warning">
        Biztosan törölni szeretnéd ezt a bérlettípust?
        A művelet nem vonható vissza.
    </div>

    <form method="post">
        <input type="hidden" asp-for="BerletTipus.Id" />

        <button type="submit" class="btn btn-danger">
            Bérlettípus törlése
        </button>

        <a asp-page="./Index" class="btn btn-secondary">
            Mégse
        </a>
    </form>
}
