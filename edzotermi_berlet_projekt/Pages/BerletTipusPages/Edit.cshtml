@page
@model edzotermi_berlet_projekt.Pages.BerletTipusPages.EditModel

@{
    ViewData["Title"] = "Bérlettípus szerkesztése";
}

<h1>Bérlettípus szerkesztése</h1>
<hr />

<div class="row">
    <div class="col-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="BerletTipus.Id" />

            <div class="form-group mb-3">
                <label asp-for="BerletTipus.Nev" class="form-label">
                    Bérlettípus neve
                </label>
                <input asp-for="BerletTipus.Nev" class="form-control" />
                <span asp-validation-for="BerletTipus.Nev" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BerletTipus.ErvenyessegNap" class="form-label">
                    Érvényesség (nap)
                </label>
                <input asp-for="BerletTipus.ErvenyessegNap"
                       type="number" min="1" max="3650"
                       class="form-control" />
                <span asp-validation-for="BerletTipus.ErvenyessegNap" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BerletTipus.BelepesekSzama" class="form-label">
                    Belépések száma (üres = korlátlan)
                </label>
                <input asp-for="BerletTipus.BelepesekSzama"
                       type="number" min="1" max="10000"
                       class="form-control" />
                <span asp-validation-for="BerletTipus.BelepesekSzama" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BerletTipus.Ar" class="form-label">
                    Ár (Ft)
                </label>
                <input asp-for="BerletTipus.Ar"
                       type="number" min="0.01" step="0.01"
                       class="form-control" />
                <span asp-validation-for="BerletTipus.Ar" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Mentés</button>
            <a asp-page="./Index" class="btn btn-secondary">Vissza a listához</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
