@page
@model edzotermi_berlet_projekt.Pages.BerletTipusPages.DetailsModel

@{
    ViewData["Title"] = "Bérlettípus részletei";
}

<h1>Bérlettípus részletei</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">Bérlettípus neve</dt>
    <dd class="col-sm-9">@Model.BerletTipus.Nev</dd>

    <dt class="col-sm-3">Érvényesség</dt>
    <dd class="col-sm-9">@Model.BerletTipus.ErvenyessegNap nap</dd>

    <dt class="col-sm-3">Belépések száma</dt>
    <dd class="col-sm-9">
        @if (Model.BerletTipus.BelepesekSzama.HasValue)
        {
            @($"{Model.BerletTipus.BelepesekSzama.Value} alkalom")
        }
        else
        {
            <span>Korlátlan</span>
        }
    </dd>

    <dt class="col-sm-3">Ár</dt>
    <dd class="col-sm-9 fw-semibold">
        @Model.BerletTipus.Ar.ToString("N0") Ft
    </dd>
</dl>

<div class="mt-3">
    <a asp-page="./Edit"
       asp-route-id="@Model.BerletTipus.Id"
       class="btn btn-primary">Szerkesztés</a>

    <a asp-page="./Index"
       class="btn btn-secondary">Vissza a listához</a>
</div>
