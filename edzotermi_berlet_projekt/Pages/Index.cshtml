@page
@model IndexModel

@{
    ViewData["Title"] = "Kezdőlap";
}

<div class="container py-5">
    <div class="p-4 p-md-5 mb-4 rounded-3 bg-light border">
        <div class="mx-auto" style="max-width: 850px;">
            <h1 class="display-5 fw-bold mb-4">
                Edzőtermi bérletkezelő alkalmazás
            </h1>

            <div class="border-start border-primary border-4 ps-3 mb-4">
                <p class="lead mb-0">
                    Az oldal segítségével nyilvántarthatóak az edzőterem tagjai,
                    a bérlettípusok, a megvásárolt bérletek és a belépések.
                    A havi bevételi kimutatás az eladói oldalról segíti a felhasználást!
                </p>
            </div>
        </div>
    </div>
</div>